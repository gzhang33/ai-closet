{
  "name": "ai-closet",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:ollama": "./scripts/run-with-ollama.sh",
    "container:up": "./scripts/dev-container-up.sh",
    "container:up:rembg-sidecar": "USE_REMBG_SIDECAR=1 ./scripts/dev-container-up.sh",
    "container:down": "./scripts/dev-container-down.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup:ollama-host": "./scripts/setup-ollama-host-macos.sh",
    "setup:rembg-host": "./scripts/setup-rembg-host-macos.sh",
    "verify:ollama": "./scripts/verify-ollama-connectivity.sh",
    "verify:ollama:docker": "docker compose -f docker/ollama-connectivity.compose.yml up --abort-on-container-exit --exit-code-from ollama-connectivity-check ollama-connectivity-check",
    "verify:rembg": "./scripts/verify-rembg-connectivity.sh",
    "verify:rembg:docker": "docker compose -f docker/rembg-connectivity.compose.yml up --abort-on-container-exit --exit-code-from rembg-connectivity-check rembg-connectivity-check"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.8.4",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "@react-navigation/stack": "^7.6.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-jwt": "^1.8.0",
    "expo-localization": "~17.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.1.0",
    "react": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-worklets": "^0.5.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/react": "~19.1.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-navigation": "^3.0.8",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "^54.0.7",
    "typescript": "~5.9.2"
  },
  "private": true
}

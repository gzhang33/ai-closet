FROM python:3.11-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libglib2.0-0 libgl1 \
  && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
  && python -m pip install --no-cache-dir "rembg[cpu,cli]"

ENV U2NET_HOME=/models

WORKDIR /app

COPY docker/rembg-entrypoint.sh /usr/local/bin/rembg-entrypoint.sh

RUN chmod +x /usr/local/bin/rembg-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/rembg-entrypoint.sh"]
